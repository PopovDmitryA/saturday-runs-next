# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
# Local dev: http://localhost:8080. For VK ID login use http://localhost (port 80) — see VK_OAUTH_* below.
# Production: https://run5k.run (legacy Grafana: https://grafana.run5k.run)
APP_BASE_URL=http://localhost:8080

# Docker nginx publish (production server: 127.0.0.1 and 8080)
# NGINX_BIND=127.0.0.1
# NGINX_HTTP_PORT=8080

# Database
# POSTGRES_PUBLISH_PORT — порт на Mac для DBeaver/psql (внутри Docker сеть остаётся 5432)
POSTGRES_PUBLISH_PORT=5433
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=saturday_runs
POSTGRES_PASSWORD=saturday_runs
POSTGRES_DB=saturday_runs_lk
DATABASE_URL=postgresql+psycopg://saturday_runs:saturday_runs@postgres:5432/saturday_runs_lk

# Internal read-only reporting API (/api/internal/reports/*)
# Пусто — эндпоинт выключен (503). Токен: openssl rand -hex 32
# Запросы: заголовок  Authorization: Bearer <token>
#   GET  /api/internal/reports/                 — список именованных отчётов
#   GET  /api/internal/reports/named/<name>     — готовый отчёт:
#          db_size | table_sizes | connections | schema | foreign_keys | indexes
#   POST /api/internal/reports/query {"sql": "SELECT ...", "limit": 100}
# Гарантии: только SELECT/WITH, транзакция READ ONLY, statement_timeout, лимит строк.
# REPORT_API_TOKEN=
# REPORT_QUERY_MAX_ROWS=5000
# REPORT_QUERY_TIMEOUT_SECONDS=15
#
# Отдельная роль только на чтение (рекомендуется). Создать один раз:
#   export REPORT_RO_PASSWORD='...'
#   psql "$DATABASE_URL" -v ON_ERROR_STOP=1 \
#        -v report_password="$REPORT_RO_PASSWORD" \
#        -f scripts/create_report_ro_role.sql
# затем указать эндпоинту ходить под ней (иначе используется DATABASE_URL):
# REPORT_DATABASE_URL=postgresql+psycopg://report_ro:PASSWORD@postgres:5432/saturday_runs_lk

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
# URL for Telegram bot → API (Docker service name, not public site URL)
API_BASE_URL=http://api:8000

# Telegram bot (user login — disabled by default; use profile telegram to start)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_INTERNAL_SECRET=
# TELEGRAM_ADMIN_CHAT_ID=
# ADMIN_TELEGRAM_ID=
# Прокси для ВСЕГО трафика к Telegram (long-poll бота + admin-уведомления):
# с прод-сервера в РФ api.telegram.org недоступен напрямую, без прокси бот
# падает в крэш-луп. Даёт сервис tg-proxy (xray-core, см. deploy/tg-proxy/),
# поднимается профилем telegram: docker compose --profile telegram up -d tg-proxy
# Именно http:// — его понимают и httpx, и aiohttp (aiogram) без доп. пакетов.
# TELEGRAM_PROXY_URL=http://tg-proxy:8118
# Admin access without Telegram: comma-separated OAuth emails (e.g. Yandex login)
# ADMIN_EMAILS=you@yandex.ru
# OAuth login (VK ID + Yandex ID)
# VK ID (https://id.vk.com): для localhost разрешены только порты 80/443.
#   Базовый домен: localhost
#   Доверенный redirect: http://localhost/oauth/vk/callback
#   APP_BASE_URL=http://localhost и nginx на порту 80 (docker-compose: 80:80)
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
# Optional override; default APP_BASE_URL/oauth/vk/callback
VK_OAUTH_REDIRECT_URI=

YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Callback URL в oauth.yandex.ru — SPA-маршрут (надёжнее на iOS Safari)
# Optional override; default APP_BASE_URL/oauth/yandex/callback
YANDEX_OAUTH_REDIRECT_URI=http://localhost:8080/oauth/yandex/callback
# Оставьте пустым — Яндекс выдаст права, выбранные при регистрации приложения.
# Достаточно только «Доступ к адресу электронной почты» (login:email): id + default_email.
# Явный scope задавайте только если он совпадает с настройками oauth.yandex.ru:
# YANDEX_OAUTH_SCOPES=login:email

# Abuse / DDoS protection (Redis + nginx limit_req). Comma-separated IPs bypass checks.
# ABUSE_PROTECTION_ENABLED=true
# ABUSE_WHITELIST_IPS=
# OAuth/login endpoints: ABUSE_AUTH_LIMIT_PER_IP (default 80 per 10 min).
# /api/auth/me and session reads use the default tier, not the auth bucket.

# S95 global sync (Celery beat → worker-s95 queue). Optional override:
# S95_GLOBAL_SYNC_LOCATIONS=zil|ЗИЛ|https://s95.ru/events/zil;angarskie_prudy|Ангарские пруды|https://s95.ru/events/angarskie_prudy
S95_GLOBAL_SYNC_PROTOCOL_LIMIT=3

# 5verst fetch throttling (Redis lock + random interval between requests, all processes)
FIVE_VERST_FETCH_MIN_INTERVAL_SECONDS=20
FIVE_VERST_FETCH_MAX_INTERVAL_SECONDS=30
FIVE_VERST_PROTOCOL_MIN_INTERVAL_SECONDS=30
FIVE_VERST_PROTOCOL_MAX_INTERVAL_SECONDS=40
FIVE_VERST_FETCH_LOCK_TIMEOUT_SECONDS=120
FIVE_VERST_FETCH_LOCK_BLOCKING_SECONDS=600
FIVE_VERST_BAN_COOLDOWN_SECONDS=600
# Sync limits (empty = unlimited for latest protocols)
FIVE_VERST_SYNC_PROTOCOL_LIMIT=
FIVE_VERST_SYNC_LATEST_UPDATE_LIMIT=
FIVE_VERST_FETCH_ALL_PROTOCOLS_ON_CHANGE=true
FIVE_VERST_LOCATION_BATCH_SUMMARIES_LIMIT=20
FIVE_VERST_RECONCILE_BATCH_LIMIT=100
FIVE_VERST_RECONCILE_MIN_CHECK_INTERVAL_DAYS=0

# VK — fallback-канал для admin-уведомлений (используется только если Telegram-прокси
# недоступен; основной admin-бот и /stats /sync и т.п. — в Telegram, см. выше).
VK_BOT_GROUP_TOKEN=
VK_ADMIN_USER_ID=

# Legacy ETL source (read-only), DB five_verst_stats — for parkrun-seed-queue:
# Read-only legacy DB for ETL / parkrun-seed-queue (not the new LK DB)
# On server Docker use host gateway 172.17.0.1; from Mac use 195.58.34.112 or localhost tunnel
# LEGACY_DATABASE_URL=postgresql+psycopg://readonly_user:PASSWORD@172.17.0.1:5432/five_verst_stats

# parkrun (Mac): one command — DB queue + Playwright Chromium + captcha wait in same window:
#   make parkrun-seed-queue   # optional: 5 profiles from legacy into queue
#   make parkrun
# PARKRUN_PLAYWRIGHT_STORAGE_STATE_PATH=/data/parkrun_playwright_state.json
# PARKRUN_PLAYWRIGHT_HEADLESS=false
# Optional CDP: PARKRUN_USE_CDP_FOR_FETCH=true PARKRUN_CDP_URL=http://127.0.0.1:9222
# Legacy CLI (needs full backend deps): scripts/parkrun_save_session_mac.sh
# PARKRUN_FETCH_MIN_INTERVAL_SECONDS=25
# PARKRUN_FETCH_MAX_INTERVAL_SECONDS=55
# PARKRUN_FETCH_BETWEEN_PAGES_DELAY_SECONDS=10
# PARKRUN_PLAYWRIGHT_PAGE_WAIT_MS=8000
# PARKRUN_PLAYWRIGHT_HEADLESS=true
# PARKRUN_PLAYWRIGHT_STORAGE_STATE_PATH=

# When platform fetch hits cooldown/ban, profile IDs are queued in profile_fetch_pending.
# Process queue (Python 3.12+): make process-pending-fetches ARGS="--clear-cooldown"

# Local runs against prod DB (scripts/run_prod_script.sh, make prod-run)
# Uses SSH tunnel; credentials from TEMP_SSH_* and TEMP_PROD_PG_* (or PROD_* aliases).
# PROD_TUNNEL_LOCAL_PORT=5434
# LOCAL_REDIS_URL=redis://127.0.0.1:6379/0
# CONFIRM_PROD=1 — required for writes (without --dry-run)
# TEMP_SSH_HOST=195.58.34.112
# TEMP_SSH_USER=viewer
# TEMP_SSH_PASSWORD=
# TEMP_PROD_PG_USER=saturday_runs
# TEMP_PROD_PG_PASSWORD=
# TEMP_PROD_PG_DATABASE=saturday_runs_lk
#
# Local site on prod data (read-only): make dev-prod-db  /  make dev-local-db
# Uses docker-compose.prod-db.yml + SSH tunnel (PROD_TUNNEL_LOCAL_PORT=5434).

# --- АБ-тест главной (эксперимент home_v1) -----------------------------------
# ── Публичное S3-хранилище картинок (фото в отзывах на локации, фото в
# карточках бэклога, аватарки) ────────────────────────────────────────────
# Пустой S3_BUCKET = локальный режим: файлы кладутся в MEDIA_DIR и
# раздаются через /api/media/... Так работают dev и тесты, кред не нужно.
# Заполненный S3_BUCKET включает загрузку в бакет; он должен быть ПУБЛИЧНЫМ
# (объекты пишутся с ACL public-read, браузер ходит за картинкой напрямую).
# S3_BUCKET=
# S3_ENDPOINT_URL=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# База для публичных ссылок; пусто — собирается как {endpoint}/{bucket}.
# S3_PUBLIC_BASE_URL=
# Папки внутри бакета — по одной на потребителя.
# S3_PREFIX_LOCATION_REVIEWS=location-reviews
# S3_PREFIX_BACKLOG=backlog
# S3_PREFIX_AVATARS=avatars
# MEDIA_DIR=/data/media
