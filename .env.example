# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
# Local dev: http://localhost:8080. For VK ID login use http://localhost (port 80) — see VK_OAUTH_* below.
APP_BASE_URL=http://localhost:8080

# Docker nginx publish (production server: 127.0.0.1 and 8080)
# NGINX_BIND=127.0.0.1
# NGINX_HTTP_PORT=8080

# Database
# POSTGRES_PUBLISH_PORT — порт на Mac для DBeaver/psql (внутри Docker сеть остаётся 5432)
POSTGRES_PUBLISH_PORT=5433
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=saturday_runs
POSTGRES_PASSWORD=saturday_runs
POSTGRES_DB=saturday_runs_lk
DATABASE_URL=postgresql+psycopg://saturday_runs:saturday_runs@postgres:5432/saturday_runs_lk

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
# URL for Telegram bot → API (Docker service name, not public site URL)
API_BASE_URL=http://api:8000

# Telegram bot (new, separate from legacy bot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_BOT_INTERNAL_SECRET=change-me-bot-secret
TELEGRAM_ADMIN_CHAT_ID=
# Telegram user id of the LK admin (tab «Очередь» and /api/sync/queue)
ADMIN_TELEGRAM_ID=
# Admin access without Telegram: comma-separated OAuth emails (e.g. Yandex login)
# ADMIN_EMAILS=you@yandex.ru
# Public demo profile on landing (/demo). If empty, uses ADMIN_TELEGRAM_ID.
DEMO_TELEGRAM_ID=

# OAuth login (VK ID + Yandex ID)
# VK ID (https://id.vk.com): для localhost разрешены только порты 80/443.
#   Базовый домен: localhost
#   Доверенный redirect: http://localhost/api/auth/oauth/vk/callback
#   APP_BASE_URL=http://localhost и nginx на порту 80 (docker-compose: 80:80)
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
# Optional override; default APP_BASE_URL/api/auth/oauth/vk/callback
VK_OAUTH_REDIRECT_URI=

YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
# Callback URL в oauth.yandex.ru (localhost:8080 ок, в отличие от VK ID)
# Optional override; default APP_BASE_URL/api/auth/oauth/yandex/callback
YANDEX_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/yandex/callback
# В кабинете oauth.yandex.ru для приложения включите те же права, что запрашивает код:
#   login:info — ID, логин, имя (display_name / real_name)
#   login:email — адрес почты (default_email)
# Телефон, аватар, день рождения и прочее не запрашиваем.

# Abuse / DDoS protection (Redis + nginx limit_req). Comma-separated IPs bypass checks.
# ABUSE_PROTECTION_ENABLED=true
# ABUSE_WHITELIST_IPS=

# S95 global sync (Celery beat → worker-s95 queue). Optional override:
# S95_GLOBAL_SYNC_LOCATIONS=zil|ЗИЛ|https://s95.ru/events/zil;angarskie_prudy|Ангарские пруды|https://s95.ru/events/angarskie_prudy
S95_GLOBAL_SYNC_PROTOCOL_LIMIT=3

# 5verst fetch throttling (Redis lock + random interval between requests, all processes)
FIVE_VERST_FETCH_MIN_INTERVAL_SECONDS=8
FIVE_VERST_FETCH_MAX_INTERVAL_SECONDS=15
FIVE_VERST_FETCH_LOCK_TIMEOUT_SECONDS=120
FIVE_VERST_FETCH_LOCK_BLOCKING_SECONDS=600
FIVE_VERST_BAN_COOLDOWN_SECONDS=600

# Legacy ETL source (read-only), DB five_verst_stats — for parkrun-seed-queue:
# Read-only legacy DB for ETL / parkrun-seed-queue (not the new LK DB)
# On server Docker use host gateway 172.17.0.1; from Mac use 195.58.34.112 or localhost tunnel
# LEGACY_DATABASE_URL=postgresql+psycopg://readonly_user:PASSWORD@172.17.0.1:5432/five_verst_stats

# parkrun (Mac): one command — DB queue + Playwright Chromium + captcha wait in same window:
#   make parkrun-seed-queue   # optional: 5 profiles from legacy into queue
#   make parkrun
# PARKRUN_PLAYWRIGHT_STORAGE_STATE_PATH=/data/parkrun_playwright_state.json
# PARKRUN_PLAYWRIGHT_HEADLESS=false
# Optional CDP: PARKRUN_USE_CDP_FOR_FETCH=true PARKRUN_CDP_URL=http://127.0.0.1:9222
# Legacy CLI (needs full backend deps): scripts/parkrun_save_session_mac.sh
# PARKRUN_FETCH_MIN_INTERVAL_SECONDS=25
# PARKRUN_FETCH_MAX_INTERVAL_SECONDS=55
# PARKRUN_FETCH_BETWEEN_PAGES_DELAY_SECONDS=10
# PARKRUN_PLAYWRIGHT_PAGE_WAIT_MS=8000
# PARKRUN_PLAYWRIGHT_HEADLESS=true
# PARKRUN_PLAYWRIGHT_STORAGE_STATE_PATH=

# When platform fetch hits cooldown/ban, profile IDs are queued in profile_fetch_pending.
# Process queue (Python 3.12+): make process-pending-fetches ARGS="--clear-cooldown"
FIVE_VERST_SYNC_PROTOCOL_LIMIT=3
FIVE_VERST_SYNC_LATEST_UPDATE_LIMIT=20
FIVE_VERST_FETCH_ALL_PROTOCOLS_ON_CHANGE=true
FIVE_VERST_RECONCILE_BATCH_LIMIT=10
FIVE_VERST_RECONCILE_MIN_CHECK_INTERVAL_DAYS=7
