FROM python:3.12-slim

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Только рантайм — см. Dockerfile. Единственное отличие этого образа — Chromium
# для Playwright (фетч parkrun с капчей, OG-картинки).
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e . \
    && playwright install --with-deps chromium

COPY . .
